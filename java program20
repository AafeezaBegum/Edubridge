public class Calculator {

    // Returns the sum of two integers
    public int calculate(int a, int b) {
        return a + b;
    }

    // Returns the product of two doubles
    public double calculate(double a, double b) {
        return a * b;
    }

    // Returns the largest of three integers
    public int calculate(int a, int b, int c) {
        return Math.max(a, Math.max(b, c));
    }

    // Returns the difference as a double
    public double calculate(int a, double b) {
        return a - b;
    }

    public static void main(String[] args) {
        Calculator calc = new Calculator();

        // Testing all four overloaded methods
        System.out.println("Sum (int, int): " + calc.calculate(10, 5));
        System.out.println("Product (double, double): " + calc.calculate(4.5, 2.0));
        System.out.println("Largest (int, int, int): " + calc.calculate(12, 45, 23));
        System.out.println("Difference (int, double): " + calc.calculate(20, 7.5));
    }
}
