// Outer class
class University {
    private String universityName = "Global Tech University";
    private String location = "New York";

    // 1. Static nested class
    static class Department {
        private String deptName;

        public Department(String deptName) {
            this.deptName = deptName;
        }

        public void displayDept() {
            System.out.println("Department Name: " + deptName);
        }
    }

    // 2. Non-static inner class
    class Faculty {
        private String facultyName;
        private String designation;

        public Faculty(String facultyName, String designation) {
            this.facultyName = facultyName;
            this.designation = designation;
        }

        public void displayFaculty() {
            System.out.println("Faculty Name: " + facultyName);
            System.out.println("Designation: " + designation);
        }
    }

    // 3. Outer-class method to display university information
    public void displayUniversityInfo() {
        System.out.println("University: " + universityName + " | Location: " + location);
    }

    // Main Method implementing the steps
    public static void main(String[] args) {
        // Step 1: Create a University object
        University myUni = new University();

        // Step 2: Create a Department object without first creating a University object
        University.Department dept = new University.Department("Computer Science");

        // Step 3: Create a Faculty object using the University object
        University.Faculty prof = myUni.new Faculty("Dr. Alan Turing", "Professor");

        // Step 4: Display all details
        System.out.println("--- University Details ---");
        myUni.displayUniversityInfo();
        
        System.out.println("\n--- Department Details ---");
        dept.displayDept();
        
        System.out.println("\n--- Faculty Details ---");
        prof.displayFaculty();
    }
}
